@echo off
cd /d %~dp0

:: Inicializar repositorio Git
git init

:: Añadir todos los archivos
git add .

:: Hacer commit
git commit -m "Portal UASM - Versión completa con datos actualizados\n\n- Datos de Ronda 1 y Ronda 2 actualizados\n- Traducción completa español ↔ inglés\n- Rango temporal: 1974–2026\n- Nombre: UASM (Minería Subterránea Artesanal)\n\nGenerated by Mistral Vibe."

:: Verificar si ya existe el remote
git remote | findstr "origin" >nul 2>&1
if %errorlevel% equ 0 (
    echo "Remote ya existe. Use: git remote -v"
) else (
    echo "\nPara subir a GitHub, ejecute:"
    echo "git remote add origin https://github.com/<YOUR_USERNAME>/portal-uasm.git"
    echo "git push -u origin main"
)

:: Mostrar estado
echo.
echo "Estado actual:"
git status
